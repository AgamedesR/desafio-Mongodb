# Copie este arquivo para ".env" e ajuste os valores conforme necessario

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dados_abertos_geo
MONGO_COLLECTION=unidades_basicas_saude

# URL do recurso CSV no dados.gov.br (pode mudar - busque "UBS CSV" no portal
# caso o link abaixo esteja quebrado)
CSV_URL=http://dados.gov.br/dataset/unidades-basicas-de-saude-ubs/resource/e8a10748-423c-433a-9523-14c1c2eba6cf

# Alternativa para rodar offline com um arquivo CSV local (deixe em branco
# para usar CSV_URL)
CSV_LOCAL_PATH=

CSV_ENCODING=utf-8
CSV_SEPARATOR=,

LOG_LEVEL=INFO
